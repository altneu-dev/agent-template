# --- digest vertical ------------------------------------------------------------------
# This vertical adds no variables of its own. What it does add is the wiring every deployment
# needs and every fork forgets: somewhere for a failed or escalated run to go.
#
# `.invalid` is the reserved TLD that can never resolve, so this default cannot quietly send a
# client's job names anywhere. Replace it, then run `agent-alert --test` and watch it arrive —
# "it is configured" and "it arrived" are different claims.
AGENT_RUN_ALERT_CMD=agent-alert
AGENT_ALERT_WEBHOOK=https://example.invalid/replace-me

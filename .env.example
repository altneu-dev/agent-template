# Copy to .env, or paste these into your platform's secret store. This file is the deploy
# checklist: `agent-run` refuses to start — before spending anything — when a name listed
# here is missing or still says <required>.
#
# NAMES AND NON-SECRET DEFAULTS BELONG HERE. VALUES NEVER DO. This file is committed.

# --- required -----------------------------------------------------------------------
# One provider credential. Pi reads it from the environment; there is no interactive login,
# which is what makes the deploy a single click with no browser step.
ANTHROPIC_API_KEY=<required>

# --- provider selection, defaults are fine ------------------------------------------
AGENT_PROVIDER=anthropic

# Left unset on purpose: pi picks the provider's default. Set it only to pin a specific
# model, and only to an id pi actually resolves — `pi --list-models` once credentials are in
# place. An unknown id fails as "No API key found for the selected model", which sends you
# looking at the credential rather than at the name.
# AGENT_MODEL=

# --- identity and scheduling --------------------------------------------------------
AGENT_NAME=agent
TZ=Europe/Berlin

# --- run limits ---------------------------------------------------------------------
# Applied by agent-run to every job unless the job file overrides them. A runaway agent is
# a cost incident and a trust incident; these are the cheap bound on both.
AGENT_RUN_TIMEOUT=900          # seconds of wall clock per run
AGENT_RUN_KEEP=30              # run directories retained under /data/logs/runs

# The memory bound, and it is not one of the above. Node sizes its heap from the HOST's RAM
# because it cannot see a container limit, so without a cap it plans for ~1 GB, never
# collects below that, and the kernel — not Node — ends the process. Left uncommented here
# it would be a third place holding one number; the Dockerfile ships the default and
# compose.yml repeats it so a platform can pass it. Uncomment only to retune, and move
# mem_limit in compose.yml with it.
# NODE_OPTIONS=--max-old-space-size=768

# --- who hears about it ---------------------------------------------------------------
# Called with the run directory as its argument whenever a run exits non-zero — a failure, and
# also an escalation, which is the agent stopping to ask a human rather than guessing.
#
# NOT OPTIONAL IN PRACTICE, even though nothing here marks it <required>. An escalation that
# reaches nobody is the same as no escalation, and unattended is a promise about who hears, not
# only about who runs. `agent-status --ready` says so when this is unset; it is left settable
# rather than mandatory because a deployment nobody has finished configuring is not broken yet.
#
# `agent-alert` ships in the image and needs AGENT_ALERT_WEBHOOK. A host-side command is
# equally fine — what must not happen is neither.
# AGENT_RUN_ALERT_CMD=agent-alert

# Where agent-alert posts. Slack, Teams and most generic receivers accept its {"text": ...}
# payload unchanged. It sends the job name, exit code, run id and the FIRST LINE of the reason
# — never the escalation request, the run's stderr or the artefact, because those quote what
# the agent was reading in a client's systems.
# AGENT_ALERT_WEBHOOK=<required>
# AGENT_ALERT_VERBOSE=          # 1 sends the full reason, for operators who decided that is fine

# Other providers, if AGENT_PROVIDER is changed:
# OPENAI_API_KEY=<required>
# GEMINI_API_KEY=<required>

# --- reaching a model you are allowed to send this data to --------------------------
# For a client who may not send data to a vendor's public API — public administration,
# healthcare, defence — the question is not which model but which jurisdiction and which
# contract. Two routes work today, and agent-run passes each one's whole set through to the
# model process, so the values may live in /data/.env and never touch the platform.
#
# A FORK MAKES THESE REQUIRED BY EDITING THIS FILE: comment out ANTHROPIC_API_KEY above and
# uncomment the set below with `<required>`. agent-secret derives what a deployment must have
# from this file alone, so that edit is the whole configuration change.
#
# Azure OpenAI — set AGENT_PROVIDER=azure. Pick the region when you create the resource
# (Sweden Central and Germany West Central are the usual EU answers); the endpoint is what
# makes the choice real, so it is not optional.
# AZURE_OPENAI_API_KEY=<required>
# AZURE_OPENAI_BASE_URL=<required>
# AZURE_OPENAI_RESOURCE_NAME=               # an alternative to the base URL, not an extra
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT_NAME_MAP=         # model=deployment pairs, comma-separated
#
# Amazon Bedrock — set AGENT_PROVIDER=bedrock. AWS_REGION is the jurisdiction (eu-central-1
# is Frankfurt), so it belongs in the same breath as the credential.
# AWS_BEARER_TOKEN_BEDROCK=<required>
# AWS_ACCESS_KEY_ID=                        # the older pair, if you have no bearer token
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=<required>
#
# A model on the client's OWN hardware is NOT reachable today: pi has no generic base-URL
# override, only the provider-specific ones above. The working trick is a proxy on the client's
# network that speaks the Azure OpenAI API in front of vLLM or similar, with
# AZURE_OPENAI_BASE_URL pointing at it. Nothing in this image does that for you. DEPLOY.md §9
# says what that costs before you promise it to anyone.

# --- this vertical's variables ------------------------------------------------------
# A fork appends its own here — every ${VAR} referenced in agent/mcp/*.json must appear in
# this file, or the agent refuses to start with the name of what is missing.
#
# HOW THEY REACH THE CONTAINER. A deployment platform passes a variable only if compose.yml
# names it, and compose.yml is frozen against verticals. So set them as NAME=value lines in
# the single AGENT_ENV variable in your platform's UI:
#
#   AGENT_ENV=HELPDESK_STORE=/data/work/tickets.json
#             HELPDESK_TOKEN=...
#
# agent-secret reads them with the same grammar as the secrets file, and they lose to a real
# environment variable of the same name. The alternative, for a client who wants credentials
# only on their own disk, is /data/.env inside the volume — invisible to the platform, and
# rotating a value means opening a terminal in the container.

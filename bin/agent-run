#!/usr/bin/env bash
# agent-run — run one job, once, with nobody watching.
#
#   agent-run <job>              run jobs/<job>.md
#   agent-run <job> --dry-run    print the exact command that would run; touch nothing
#   agent-run <job> --probe-tools  ask pi what tools this job really gets; costs nothing
#   agent-run --list             the jobs this deployment defines
#
# This is the unit of automation. A job file declares what the agent may use; this builds the
# run from that declaration, refuses to start when the deployment is misconfigured, and
# records what happened where something other than a human can read it.
#
# Exit codes are the interface a scheduler consumes:
#
#    0  ran, produced a result, and met the outcome contract
#   10  preflight failed — configuration is wrong. NO model call was made, nothing was spent
#   11  refused: this job is already running, or the caller is itself a run (see below)
#   20  provider or authentication error — configuration is wrong, do NOT retry
#   21  provider temporarily unavailable (rate limit, overload) — safe to retry
#   22  timed out
#   30  ran, but produced no result
#   31  ran and claimed to be done, but the outcome contract was not met
#   32  stopped deliberately and asked for a human (the agent called `escalate`)
#   40  internal error
#
# 10 is the important one: a misconfigured deployment must cost nothing and must say which
# variable is missing, rather than failing somewhere inside a run with an opaque auth error.
#
# 31 is the other one. Exit 0 used to mean "the model finished", not "the task was done" —
# and a confidently wrong answer is the failure agent/AGENTS.md names as the worst kind. A job
# can now declare what its work must leave behind, and the harness checks it rather than
# taking the model's word. Kept distinct from 30 because they need opposite responses: 30 is
# usually the provider, 31 is the agent.
#
# 11 covers two refusals, because a scheduler's answer to both is the same one: leave it alone.
# The second is new and no scheduler will ever see it — a run tried to start another run. That
# path exists only from inside a job that declared a shell, and it is refused because the tool
# ceiling is per job; see the guard further down for why nesting would dissolve it.
set -uo pipefail

APP="${AGENT_APP:-/app}"
DATA="${AGENT_DATA:-/data}"
JOBS="$DATA/jobs"
RUNS="$DATA/logs/runs"

die() { echo "agent-run: $*" >&2; exit 40; }

# ---------------------------------------------------------------- arguments
DRY=0
PROBE=0
JOB=""
EXTRA=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --probe-tools) PROBE=1; shift ;;
    --list)
      [ -d "$JOBS" ] || { echo "no jobs directory at $JOBS"; exit 0; }
      found=0
      for f in "$JOBS"/*.md; do
        [ -e "$f" ] || continue
        b=$(basename "$f" .md); [ "$b" = "README" ] && continue
        d=$(sed -n 's/^description:[[:space:]]*//p' "$f" | head -1)
        printf '  %-24s %s\n' "$b" "$d"; found=1
      done
      [ "$found" = 0 ] && echo "no jobs defined — add one to agent/jobs/ (see its README)"
      exit 0 ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; EXTRA+=("$@"); break ;;
    -*) die "unknown option $1" ;;
    *)  if [ -z "$JOB" ]; then JOB="$1"; else EXTRA+=("$1"); fi; shift ;;
  esac
done
[ -n "$JOB" ] || { echo "usage: agent-run <job> [--dry-run]   ('agent-run --list' shows them)" >&2; exit 40; }

JOB_FILE="$JOBS/$JOB.md"
[ -f "$JOB_FILE" ] || {
  echo "agent-run: no such job: $JOB" >&2
  echo "  jobs live in agent/jobs/ and arrive with the deployment; 'agent-run --list' shows them." >&2
  exit 10
}

# ---------------------------------------------------------------- job file
# Front matter drives the run. Parsed with python because YAML-ish parsing in bash is how
# quoting accidents become security decisions.
eval "$(python3 - "$JOB_FILE" <<'PY'
import re, shlex, sys
raw = open(sys.argv[1], encoding='utf-8', errors='replace').read()
meta, body = {}, raw
m = re.match(r'^---\s*\n(.*?)\n---\s*\n?(.*)$', raw, re.S)
if m:
    body = m.group(2)
    for line in m.group(1).splitlines():
        line = line.strip()
        if not line or line.startswith('#') or ':' not in line:
            continue
        k, v = line.split(':', 1)
        v = v.strip().strip('"').strip("'")
        meta[k.strip()] = v

def listv(key):
    return [x.strip() for x in meta.get(key, '').split(',') if x.strip()]

out = {
    'JOB_DESC':    meta.get('description', ''),
    'JOB_TOOLS':   ','.join(listv('tools')),
    'JOB_MCP':     ' '.join(listv('mcp')),
    'JOB_ALLOW':   ','.join(listv('allow')),
    'JOB_SKILLS':  ' '.join(listv('skills')),
    'JOB_TIMEOUT': meta.get('timeout_s', ''),
    'JOB_MODEL':   meta.get('model', ''),
    'JOB_PROVIDER':meta.get('provider', ''),
    'JOB_THINKING':meta.get('thinking', ''),
    # The outcome contract. Newline-joined rather than space-joined like mcp/skills: these are
    # paths, and a client's directory names contain spaces sooner or later.
    'JOB_REQUIRES':'\n'.join(listv('requires')),
    'JOB_PRODUCES':'\n'.join(listv('produces')),
    'JOB_VERIFY':  meta.get('verify', ''),
    'JOB_PROMPT':  body.strip(),
}
for k, v in out.items():
    print(f"{k}={shlex.quote(v)}")
PY
)" || die "cannot parse $JOB_FILE"

[ -n "${JOB_PROMPT:-}" ] || { echo "agent-run: $JOB.md has no prompt below its front matter" >&2; exit 10; }

# Settings resolve job front matter first, then agent-secret — which itself reads the
# environment, then the secrets file, then .env.example's default. Reading $AGENT_PROVIDER
# directly here would skip the last of those, so the committed default would silently never
# apply and pi would fall back to its own provider instead.
cfg() { agent-secret get "$1" 2>/dev/null || printf '%s' "${2:-}"; }

TIMEOUT="${JOB_TIMEOUT:-$(cfg AGENT_RUN_TIMEOUT 900)}"
PROVIDER="${JOB_PROVIDER:-$(cfg AGENT_PROVIDER)}"
MODEL="${JOB_MODEL:-$(cfg AGENT_MODEL)}"

# Contract paths are relative to /data — the volume, where a job's work lives — unless the job
# gives an absolute one.
abspath() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$DATA" "$1" ;; esac; }

# ---------------------------------------------------------------- preflight (costs nothing)
if [ "$DRY" = 0 ]; then
  agent-init || exit 10

  if ! agent-secret check -q; then
    echo "agent-run: this deployment is not configured — nothing was run and nothing was spent." >&2
    agent-secret check >&2
    exit 10
  fi

  if [ -n "${JOB_MCP:-}" ] && ! agent-mcp check >/dev/null 2>&1; then
    echo "agent-run: MCP is not usable for job '$JOB' — nothing was run." >&2
    agent-mcp check >&2
    exit 10
  fi

  # A checker that does not exist would be discovered after the money was spent, and would
  # then have to either fail the run or be ignored — both wrong. Catch it here instead.
  if [ -n "${JOB_VERIFY:-}" ]; then
    # Split into an array rather than with `set --`: `verify:` may carry arguments, exactly as
    # AGENT_RUN_ALERT_CMD does, and clobbering the positional parameters here would be a
    # side effect waiting to surprise whatever reads them next.
    read -r -a VERIFY_CMD <<< "$JOB_VERIFY"
    command -v "${VERIFY_CMD[0]}" >/dev/null 2>&1 || {
      echo "agent-run: job '$JOB' declares verify: ${VERIFY_CMD[0]}, which this deployment does not have." >&2
      echo "  A vertical ships its checkers in bin/, alongside its jobs." >&2
      exit 10
    }
  fi

  # An input the job needs must already be there. This is what makes a propose -> commit chain
  # safe: the commit job cannot run against a proposal that was never written, and finding that
  # out costs nothing, because it happens before the model is called.
  if [ "$PROBE" = 0 ] && [ -n "${JOB_REQUIRES:-}" ]; then
    MISSING=()
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      [ -e "$(abspath "$p")" ] || MISSING+=("$p")
    done <<< "$JOB_REQUIRES"
    if [ ${#MISSING[@]} -gt 0 ]; then
      echo "agent-run: job '$JOB' requires input that is not there — nothing was run." >&2
      for p in "${MISSING[@]}"; do echo "  missing: $p" >&2; done
      exit 10
    fi
  fi
fi

# ---------------------------------------------------------------- build the command
# The safety spine, applied to every run regardless of what the job says:
#
#   --print          non-interactive; nobody is here to answer a prompt
#   --mode json      a machine-readable record instead of a terminal transcript
#   -na              ignore project-local dynamic config. /data is writable by the agent, so
#                    without this a file the agent itself wrote could load an extension on
#                    the next run. Verified not to affect AGENTS.md discovery.
#   -ne              no extension discovery; only extensions named here load
#   --tools          the allowlist from the job. Verified: pi honours this over built-in,
#                    extension and custom tools alike, so a tool absent here does not exist
#                    during the run
ARGS=(--print --mode json -na -ne)

# --- MCP: resolve the tool names BEFORE --tools is built --------------------------------
# `--tools` is a hard ceiling: verified against pi 0.84, a tool absent from it is missing
# from getAllTools() entirely and an extension cannot add it back. So every MCP tool the job
# should have must be named here, or the extension will register it into a void.
MCP_TOOL_LIST=""
if [ -n "${JOB_MCP:-}" ]; then
  [ -f "$APP/agent/extensions/mcp-tools.ts" ] || die "job declares mcp but the extension is missing"

  if [ -n "${JOB_ALLOW:-}" ]; then
    MCP_TOOL_LIST="$JOB_ALLOW"
  elif [ "$DRY" = 0 ] || [ "$PROBE" = 1 ]; then
    # No `allow:` line — ask the servers what they offer and grant all of it. Convenient
    # while building a job, and recorded in meta.json so a widened surface is never silent.
    # An explicit `allow:` is better: it does not change when a server is upgraded.
    MCP_TOOL_LIST=$(agent-mcp tools $JOB_MCP 2>/dev/null | paste -sd, -)
    [ -n "$MCP_TOOL_LIST" ] || {
      echo "agent-run: job '$JOB' declares mcp: $JOB_MCP but no tools could be listed." >&2
      echo "  Check with: agent-mcp probe" >&2
      exit 10
    }
    echo "agent-run: job '$JOB' has no 'allow:' line — granting every tool the servers offer:" >&2
    echo "  $MCP_TOOL_LIST" >&2
  fi
fi

# Built-ins from the job, plus the MCP tools resolved above. One flag, one ceiling.
TOOL_LIST="${JOB_TOOLS:-}"
if [ -n "$MCP_TOOL_LIST" ]; then
  TOOL_LIST="${TOOL_LIST:+$TOOL_LIST,}$MCP_TOOL_LIST"
fi

if [ -n "$TOOL_LIST" ]; then
  ARGS+=(--tools "$TOOL_LIST")
else
  # A job that declares no tools gets none. Silence here would mean "all of them", which is
  # the wrong default for something that runs unattended against a client's systems.
  ARGS+=(--no-tools)
fi

[ -n "${JOB_MCP:-}" ] && ARGS+=(-e "$APP/agent/extensions/mcp-tools.ts")

# The escalate tool exists only for a job that declared it. The ceiling applies to the safe
# path exactly as it does to the dangerous ones: a tool that appears without being declared is
# the class of surprise --tools exists to make impossible, and carving out an exception for a
# well-meaning tool would end that guarantee for all of them.
case ",${JOB_TOOLS:-}," in
  *,escalate,*)
    [ -f "$APP/agent/extensions/escalate.ts" ] \
      || die "job '$JOB' declares the escalate tool but agent/extensions/escalate.ts is missing"
    ARGS+=(-e "$APP/agent/extensions/escalate.ts") ;;
esac

if [ -n "${JOB_SKILLS:-}" ]; then
  for s in $JOB_SKILLS; do
    if   [ -e "$DATA/skills/$s" ];          then ARGS+=(--skill "$DATA/skills/$s")
    elif [ -e "$DATA/skills/$s/SKILL.md" ]; then ARGS+=(--skill "$DATA/skills/$s/SKILL.md")
    else echo "agent-run: job '$JOB' names skill '$s', which this deployment does not have" >&2; exit 10
    fi
  done
else
  ARGS+=(--no-skills)
fi

[ -n "$PROVIDER" ]           && ARGS+=(--provider "$PROVIDER")
[ -n "$MODEL" ]              && ARGS+=(--model "$MODEL")
[ -n "${JOB_THINKING:-}" ]   && ARGS+=(--thinking "$JOB_THINKING")

# Sessions are off by default: runs do not share memory, so there is nothing to resume, and a
# session file would hold whatever the agent read from the client's systems. Continuity comes
# from what the job writes down, not from conversation history.
if [ "${AGENT_RUN_SESSION:-}" = "keep" ]; then
  ARGS+=(--session-dir "$DATA/.pi/sessions")
else
  ARGS+=(--no-session)
fi

PROMPT="$JOB_PROMPT"
[ ${#EXTRA[@]} -gt 0 ] && PROMPT="$PROMPT"$'\n\n'"${EXTRA[*]}"

# --probe-tools answers "what will this job actually be able to do?" from pi itself rather
# than from reading config. It starts a real session with the real arguments, prints the tool
# surface, and stops before any model request — so it costs nothing and needs no credentials
# beyond passing preflight. This is also the assertion CI runs.
if [ "$PROBE" = 1 ]; then
  [ -f "$APP/ci/tools-probe.ts" ] || die "ci/tools-probe.ts is missing"
  # The extension needs its config here too, or it registers nothing and the probe would
  # report a smaller surface than a real run — the wrong direction for a safety check to err.
  if [ -n "${JOB_MCP:-}" ]; then
    agent-init >/dev/null 2>&1
    AGENT_MCP_CONFIG=$(AGENT_MCP_PID=$$ agent-mcp render 2>/dev/null) || \
      die "cannot render the MCP config for --probe-tools"
    export AGENT_MCP_CONFIG
    export AGENT_MCP_SERVERS="$JOB_MCP"
    export AGENT_MCP_ALLOW="$MCP_TOOL_LIST"
  fi
  out=$(cd "$DATA" && timeout 60 pi "${ARGS[@]}" --offline -e "$APP/ci/tools-probe.ts" \
          "probe" </dev/null 2>&1 | grep -o 'TOOLPROBE:.*' | head -1)
  [ -n "$out" ] || { echo "agent-run: could not determine the tool surface for '$JOB'" >&2; exit 40; }
  echo "${out#TOOLPROBE:}"
  exit 0
fi

if [ "$DRY" = 1 ]; then
  echo "job:      $JOB${JOB_DESC:+  — $JOB_DESC}"
  echo "timeout:  ${TIMEOUT}s"
  echo "tools:    ${JOB_TOOLS:-<none>}"
  echo "mcp:      ${JOB_MCP:-<none>}${JOB_ALLOW:+   allow: $JOB_ALLOW}"
  echo "skills:   ${JOB_SKILLS:-<none>}"
  echo "requires: $(printf '%s' "${JOB_REQUIRES:-}" | paste -sd' ' - | sed 's/^$/<nothing>/')"
  echo "produces: $(printf '%s' "${JOB_PRODUCES:-}" | paste -sd' ' - | sed 's/^$/<unchecked>/')"
  echo "verify:   ${JOB_VERIFY:-<none>}"
  echo "command:"
  printf '  pi'; for a in "${ARGS[@]}"; do printf ' %q' "$a"; done; printf ' <prompt>\n'
  exit 0
fi

# ---------------------------------------------------------------- no run starts a run
#
# The tool ceiling is per JOB, which is what makes propose/commit a guarantee rather than a
# request: the propose job cannot reach the outside system because the mutating tool does not
# exist in its runtime. That holds only while a run cannot start a different run — otherwise a
# job with a shell reaches /app/bin/agent-run, which is on PATH for every descendant, and
# re-derives the credential from /data/.env on its own. Its parent's ceiling would never come
# into it. One `bash` in one job would lift the separation for every job in the container.
#
# So the invariant is enforced here rather than left to review: AGENT_RUN_ID is set for the
# duration of a run and inherited by everything the run spawns. Finding it set means we are
# inside one.
#
# Checked at this point, and not earlier, so that --list, --dry-run and --probe-tools keep
# working from inside a run. They read; they cannot start anything.
#
# What this does NOT do, stated plainly because a control whose limits are unclear gets
# trusted for more than it does: a job author who wants nesting can `unset AGENT_RUN_ID` and
# have it. This stops the accident and the prompt-injected instruction — the model does not
# get to widen its own surface by calling another job — not a fork that has decided otherwise.
# That is deliberate: an escape hatch nobody can find would only be worked around in a way
# nobody can see. Blessing one with a flag would turn the decision into a checkbox ticked in
# the same commit as the risky line.
if [ -n "${AGENT_RUN_ID:-}" ]; then
  echo "agent-run: refusing to start '$JOB' from inside run ${AGENT_RUN_ID} of '${AGENT_JOB:-?}'." >&2
  echo "  A run cannot start another run: the tool ceiling is declared per job, and nesting" >&2
  echo "  would let one job borrow another job's tools. If this job needs what '$JOB' can do," >&2
  echo "  declare it in the job file, or split the work across two scheduled jobs." >&2
  exit 11
fi

# ---------------------------------------------------------------- one at a time
mkdir -p "$RUNS/$JOB" 2>/dev/null
exec 9>"$RUNS/$JOB/.lock" || die "cannot create the run lock"
if ! flock -n 9; then
  echo "agent-run: '$JOB' is already running — leaving it alone." >&2
  exit 11
fi

RUN_ID=$(tr -dc 'a-f0-9' </proc/sys/kernel/random/uuid | cut -c1-12)
STAMP=$(date -u '+%Y%m%dT%H%M%SZ')
RUN_DIR="$RUNS/$JOB/$STAMP-$RUN_ID"
mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR" || die "cannot create $RUN_DIR"

# Identity for the extensions that record things. Exported unconditionally, because both the
# action ledger and an escalation have to be attributable to a run, and an extension left to
# derive this itself would derive it wrongly on exactly the fork with an unusual layout.
export AGENT_RUN_ID="$RUN_ID"
export AGENT_JOB="$JOB"
export AGENT_ESCALATION_DIR="$DATA/work/escalations"
export AGENT_ESCALATION_MARKER="$RUN_DIR/escalated"

# Retention is a privacy control as much as a disk one: run records hold whatever the agent
# read from the client's systems.
KEEP="$(cfg AGENT_RUN_KEEP 30)"
ls -1dt "$RUNS/$JOB"/*-* 2>/dev/null | tail -n +$((KEEP + 1)) | while IFS= read -r old; do
  [ -d "$old" ] && rm -rf "$old"
done

MCP_SERVERS=""
if [ -n "${JOB_MCP:-}" ]; then
  # The rendered config holds real credentials, so it goes to container-local tmpfs at 0600
  # and only its path is passed on. Named after this process, and reaped by the next run when
  # /proc says the owner is gone — a run killed by its own timeout never gets to clean up.
  MCP_CFG=$(AGENT_MCP_PID=$$ agent-mcp render 2>>"$RUN_DIR/stderr.log")
  case $? in
    0) ;;
    2) echo "agent-run: job '$JOB' declares mcp but no definitions were found" >&2; exit 10 ;;
    *) echo "agent-run: MCP config could not be rendered" >&2; exit 10 ;;
  esac
  export AGENT_MCP_CONFIG="$MCP_CFG"
  export AGENT_MCP_SERVERS="$JOB_MCP"
  export AGENT_MCP_ALLOW="$MCP_TOOL_LIST"
  MCP_SERVERS="$JOB_MCP"

  # The action ledger: every call that reaches outside the container. The extension is told
  # where to write rather than deriving it — a path it guessed would be one more thing to get
  # wrong on a fork with a different layout, and it would fail silently by writing somewhere
  # nobody looks. Not set for --probe-tools, which never calls a tool.
  export AGENT_EFFECTS_LOG="$DATA/logs/effects.jsonl"
fi

START=$(date -u +%s)
printf '%s' "$PROMPT" > "$RUN_DIR/prompt.txt"
cd "$DATA" || die "cannot enter $DATA"

# The credential reaches pi through the environment of this one child process, and nowhere
# else. Not `--api-key`, which would put the secret in `ps` and in /proc/<pid>/cmdline for
# every process on the host to read. Not `set -a; . .env`, which would export every value to
# every descendant including whatever an MCP server spawns.
# A PROVIDER IS MORE THAN A KEY. One variable was enough only while the answer was always
# "the vendor's public API". A deployment that may not send client data to a third party —
# administration, healthcare, defence — reaches its model somewhere it can name: Azure OpenAI
# in an EU region, or Bedrock in eu-central-1. Those need an endpoint as well as a credential,
# and an endpoint that does not arrive fails as an authentication error against the wrong host.
#
# Names are listed here, never values: each is resolved through agent-secret, so the value may
# sit in /data/.env and stay out of the container's environment entirely. That is the whole
# point for a client who will not put a credential into a platform's database — and it is why
# these cannot simply be left to the container env, which every process here can read.
case "${AGENT_PROVIDER_VARS:-${AGENT_API_KEY_VAR:-}}" in
  "") case "$PROVIDER" in
        anthropic*)      PROVIDER_VARS="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN" ;;
        openai)          PROVIDER_VARS="OPENAI_API_KEY" ;;
        azure*)          PROVIDER_VARS="AZURE_OPENAI_API_KEY AZURE_OPENAI_BASE_URL
                                        AZURE_OPENAI_RESOURCE_NAME AZURE_OPENAI_API_VERSION
                                        AZURE_OPENAI_DEPLOYMENT_NAME_MAP" ;;
        bedrock*|aws*)   PROVIDER_VARS="AWS_BEARER_TOKEN_BEDROCK AWS_ACCESS_KEY_ID
                                        AWS_SECRET_ACCESS_KEY AWS_REGION AWS_PROFILE" ;;
        google*|gemini*) PROVIDER_VARS="GEMINI_API_KEY GOOGLE_API_KEY" ;;
        *)               PROVIDER_VARS="" ;;
      esac ;;
  # AGENT_PROVIDER_VARS names the set for a provider this table does not know. The older
  # AGENT_API_KEY_VAR still works and means the same thing for a single variable.
  *)  PROVIDER_VARS="${AGENT_PROVIDER_VARS:-$AGENT_API_KEY_VAR}" ;;
esac

# A provider needs SOME of its variables, not all: Azure takes either a base URL or a resource
# name, Bedrock either a bearer token or an access-key pair, Google either name for its key.
# Deciding which combination is valid is the provider's job. What matters here is that an
# unresolved name is left out rather than passed as an empty string — an empty AWS_PROFILE is
# not the same as no AWS_PROFILE, and an empty AZURE_OPENAI_BASE_URL overrides a good one.
PROVIDER_ENV=()
for v in $PROVIDER_VARS; do
  val=$(agent-secret get "$v" 2>/dev/null) || val=""
  [ -n "$val" ] && PROVIDER_ENV+=("$v=$val")
done

if [ ${#PROVIDER_ENV[@]} -gt 0 ]; then
  env "${PROVIDER_ENV[@]}" \
    timeout --signal=TERM --kill-after=20 "$TIMEOUT" \
    pi "${ARGS[@]}" "$PROMPT" </dev/null >"$RUN_DIR/result.jsonl" 2>"$RUN_DIR/stderr.log"
else
  # Nothing resolved: pi falls back to whatever is already in the environment, which is how a
  # platform-injected credential for a provider this table does not know still works.
  timeout --signal=TERM --kill-after=20 "$TIMEOUT" \
    pi "${ARGS[@]}" "$PROMPT" </dev/null >"$RUN_DIR/result.jsonl" 2>"$RUN_DIR/stderr.log"
fi
PI_RC=$?
END=$(date -u +%s)

# pi exits 0 even when it never reached a model — verified: with no credentials it emits a
# session header, prints the reason on stderr, and returns 0. So the exit code alone cannot
# be trusted, and the outcome is judged from what the run actually produced.
# Outcome, cost and tokens all come from the same pass over pi's stream. The schema, verified
# against a real failure: assistant messages carry `stopReason` and, when something went
# wrong, `errorMessage`; `usage.cost.total` is the money. `agent_end.messages` is the
# authoritative list — message_end and turn_end repeat the same message, so summing those
# would double-count every run's cost.
read -r STATUS COST TOKENS < <(python3 - "$RUN_DIR/result.jsonl" "$RUN_DIR/stderr.log" "$PI_RC" "$RUN_DIR/error.txt" <<'PY'
import json, re, sys
res, err, rc, errout = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]

msgs, fallback = [], []
try:
    for line in open(res, encoding='utf-8', errors='replace'):
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        if ev.get('type') == 'agent_end' and isinstance(ev.get('messages'), list):
            msgs = ev['messages']
        elif ev.get('type') == 'message_end':
            m = ev.get('message') or {}
            if m.get('role') == 'assistant':
                fallback.append(m)
except OSError:
    pass
if not msgs:
    msgs = fallback

produced, cost, tokens = False, 0.0, 0

# The error that ENDED the session, not the first one that appeared in it. A turn that failed
# and was retried successfully is not a failed run. Keeping the first error was how a run that
# did its work came back as 21 "safe to retry" — which a scheduler answers by running again a
# commit job that had already committed.
ended_in_error = None
for m in msgs:
    if not isinstance(m, dict) or m.get('role') != 'assistant':
        continue
    u = m.get('usage') or {}
    c = (u.get('cost') or {}).get('total')
    if isinstance(c, (int, float)):
        cost += c
    t = u.get('totalTokens')
    if isinstance(t, int):
        tokens += t
    ended_in_error = str(m.get('errorMessage', '')) if m.get('stopReason') == 'error' else None
    content = m.get('content')
    if isinstance(content, list) and any(
            (p.get('text') or '').strip() for p in content if isinstance(p, dict)):
        produced = True

stderr = ''
try:
    stderr = open(err, encoding='utf-8', errors='replace').read()
except OSError:
    pass

# Auth is a configuration fault and must never be retried; rate limits and overload are
# transient and should be. A scheduler that cannot tell them apart either hammers a broken
# credential or gives up on a busy provider.
#
# Matched on whole words, because these tokens are short enough to appear inside unrelated
# text: `500` lives in `1500ms`, and a `permission denied` from reading a file is not an auth
# fault. Free text is the weakest evidence there is, so it is consulted only about a run with
# nothing better to go on.
def fault(text):
    t = (text or '').lower()
    if re.search(r'\b(401|403)\b', t) or any(s in t for s in (
            'authentication', 'invalid x-api-key', 'invalid api key', 'no api key',
            'unauthorized', 'permission_error')):
        return 20
    if re.search(r'\b(429|500|502|503|529)\b', t) or any(s in t for s in (
            'rate limit', 'overloaded', 'capacity', 'timeout', 'econnreset')):
        return 21
    return None

# ORDER MATTERS, and this is it:
#
#   1. killed by the timeout        the harness knows this first-hand
#   2. the session ENDED in a fault we recognise
#   3. it produced something        then it ran, and the outcome contract judges the rest
#   4. nothing at all               classify from whatever text exists, else 30/40
#
# 3 sits above the text matching deliberately. Before, any provider-shaped substring anywhere
# in the run's stderr outranked the fact that the work was done — and because the contract is
# only evaluated for a run that otherwise succeeded, the misclassified run skipped its own
# `produces:`/`verify:` check on the way out. The check most likely to catch a lie was the one
# turned off by a number in a log line.
#
# An error we cannot classify no longer decides anything by itself: the run falls through to
# `produced` and the contract, which is the stronger evidence and does not depend on a
# provider's choice of wording.
end_fault = fault(ended_in_error) or fault(stderr) if ended_in_error is not None else None
if rc in (124, 137):
    status = 22
elif end_fault:
    status = end_fault
elif produced:
    status = 0
elif fault(stderr):
    status = fault(stderr)
elif rc != 0:
    status = 40
else:
    status = 30

# Only for a run that actually ended badly. A recovered turn used to leave an error.txt behind
# on a successful run, which is a fault report for something that did not fail.
if ended_in_error:
    open(errout, 'w').write(ended_in_error[:2000])
print(status, round(cost, 6), tokens)
PY
)
[ -n "${STATUS:-}" ] || STATUS=40
[ -n "${COST:-}" ] || COST=0
[ -n "${TOKENS:-}" ] || TOKENS=0

# ---------------------------------------------------------------- a deliberate stop
# An escalation outranks the contract. A job that escalated did not produce its artefact ON
# PURPOSE, and reporting that as "claimed to be done but was not" would blame the agent for
# doing precisely the right thing — and would teach the next person reading the logs that
# escalating looks like failing.
#
# Only from a clean run: if the provider also fell over, that is the more useful fault.
if [ "$STATUS" = 0 ] && [ -s "$RUN_DIR/escalated" ]; then
  STATUS=32
  head -1 "$RUN_DIR/escalated" > "$RUN_DIR/error.txt"
fi

# ---------------------------------------------------------------- the outcome contract
# The model saying it is finished is not evidence that it is. If the job declared what its work
# must leave behind, that is checked here, by something the model cannot talk out of it.
#
# Only when the run otherwise succeeded: 20, 21, 22 and 30 are more informative than 31, and
# overwriting one of them would send a scheduler chasing the wrong fault.
#
# `produces` is checked for existence, content AND freshness. Freshness is the one that earns
# its keep — an artefact left over from last week makes a run that did nothing look successful,
# which is precisely the failure this exists to catch. A job whose output legitimately may not
# change should express that as a `verify:` command instead.
CONTRACT="none"
if [ "$STATUS" = 0 ] && { [ -n "${JOB_PRODUCES:-}" ] || [ -n "${JOB_VERIFY:-}" ]; }; then
  CONTRACT="ok"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    f="$(abspath "$p")"
    if   [ ! -e "$f" ]; then CONTRACT="did not produce $p"
    elif [ ! -s "$f" ]; then CONTRACT="produced $p, but it is empty"
    elif [ "$(stat -c %Y "$f" 2>/dev/null || echo 0)" -lt "$START" ]; then
      CONTRACT="did not write $p during this run — the file is older than the run"
    else continue
    fi
    break
  done <<< "${JOB_PRODUCES:-}"

  if [ "$CONTRACT" = ok ] && [ -n "${JOB_VERIFY:-}" ]; then
    read -r -a VERIFY_CMD <<< "$JOB_VERIFY"
    if ! "${VERIFY_CMD[@]}" "$RUN_DIR" >"$RUN_DIR/verify.log" 2>&1; then
      CONTRACT="verify failed: ${VERIFY_CMD[0]} (see verify.log)"
    fi
  fi

  if [ "$CONTRACT" != ok ]; then
    STATUS=31
    printf '%s\n' "$CONTRACT" > "$RUN_DIR/error.txt"
  fi
fi

python3 - "$RUN_DIR/meta.json" "$JOB" "$RUN_ID" "$STAMP" "$START" "$END" "$STATUS" "$PI_RC" "$MCP_SERVERS" "$TOOL_LIST" "$COST" "$TOKENS" "$RUN_DIR/error.txt" "$CONTRACT" <<'PY'
import json, os, sys
p, job, rid, stamp, start, end, status, rc, mcp, tools, cost, tokens, errf, contract = sys.argv[1:15]
err = ""
if os.path.isfile(errf):
    err = open(errf, encoding='utf-8', errors='replace').read().strip()[:300]
json.dump({
    "job": job, "run_id": rid, "started_utc": stamp,
    "duration_s": int(end) - int(start),
    "exit": int(status), "pi_exit": int(rc),
    "cost_usd": float(cost), "tokens": int(tokens),
    "tools": [t for t in tools.split(',') if t],
    "mcp": mcp.split() if mcp else [],
    # "none" when the job declared no contract — distinct from "ok", which means one was
    # declared and held. A fleet audit wants to tell "checked and fine" from "never checked".
    "contract": contract,
    "error": err,
}, open(p, 'w'), indent=2)
PY

# One append-only line per run: the timeline something other than a human can read.
python3 - "$DATA/logs/runs.jsonl" "$RUN_DIR/meta.json" "$RUN_DIR" <<'PY'
import json, sys
line = json.load(open(sys.argv[2]))
line["dir"] = sys.argv[3]
with open(sys.argv[1], 'a') as fh:
    fh.write(json.dumps(line) + "\n")
PY
cp "$RUN_DIR/meta.json" "$RUNS/$JOB/last.json" 2>/dev/null

if [ "$STATUS" = 32 ]; then
  # Not a failure, and it must not read like one — an agent that stops rather than guesses is
  # doing the thing context/ asked for. It still alerts, because an escalation nobody sees is
  # the same as no escalation.
  echo "agent-run: '$JOB' escalated and stopped: $(head -1 "$RUN_DIR/escalated")" >&2
  echo "  the request is in $DATA/work/escalations/" >&2
  [ -n "${AGENT_RUN_ALERT_CMD:-}" ] && $AGENT_RUN_ALERT_CMD "$RUN_DIR" >/dev/null 2>&1
elif [ "$STATUS" != 0 ]; then
  echo "agent-run: '$JOB' failed (exit $STATUS). Details: $RUN_DIR" >&2
  if [ "$STATUS" = 31 ]; then
    # The model finished and was pleased with itself. Say what it actually failed to do,
    # because pi's stderr will contain nothing about it.
    echo "  the job claimed to be done, but: $CONTRACT" >&2
  fi
  sed -n '1,5p' "$RUN_DIR/stderr.log" >&2 2>/dev/null
  # The container has no way to send anything by design, so alerting is the host's job.
  [ -n "${AGENT_RUN_ALERT_CMD:-}" ] && $AGENT_RUN_ALERT_CMD "$RUN_DIR" >/dev/null 2>&1
fi
exit "$STATUS"

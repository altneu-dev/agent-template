#!/usr/bin/env bash
# kb — this agent's memory: SQLite FTS5 over the markdown it can read and write.
#
#   kb index            (re)build index.db and INDEX.md from the sources
#   kb search "query"   ranked full-text search, printed as path:line like rg
#   kb add "title"      create a new append-only note (content from stdin if piped)
#   kb schema           what is indexed, and where it comes from
#   kb sources          the resolved source list, one glob per line
#
# Why not a vector database: at this corpus size (~100 documents, ~125k tokens) embedding
# search costs more tokens than it saves. A typical RAG query returns 5-10 chunks of ~500
# tokens, mostly chaff; `kb search` plus reading the right 40 lines costs ~400 and is
# deterministic. Revisit only with recorded cases of FTS5 missing the right passage — and
# then add sqlite-vec to THIS file, not a separate service.
#
# Everything indexed lives under /data, so memory survives a redeploy. context/ is a symlink
# into /app, which means the deployment's own instructions are searchable too and are
# refreshed by a deploy rather than going stale in the index.
set -uo pipefail

DATA="${AGENT_DATA:-/data}"
APP="${AGENT_APP:-/app}"
KB_DIR="$DATA/knowledge"
DB="$KB_DIR/index.db"
INDEX_MD="$KB_DIR/INDEX.md"

# Sources are declarable so a vertical can index whatever its work produces without editing
# this file. One glob per line; blank lines and # comments ignored. Absent config gives the
# defaults below, so the common case needs no configuration at all.
#
# `kb schema` prints this same resolved list rather than a hardcoded copy — a second literal
# is a second thing to forget when the list changes.
sources_globs() {
  local cfg
  for cfg in "$DATA/.kb-sources" "$APP/kb-sources"; do
    if [ -f "$cfg" ]; then
      grep -vE '^\s*(#|$)' "$cfg"
      return
    fi
  done
  printf '%s\n' \
    "$KB_DIR/notes" \
    "$DATA/context" \
    "$DATA/work"
}

sources() {
  local g
  while IFS= read -r g; do
    [ -n "$g" ] || continue
    # -L so the context/ symlink into /app is followed; without it the deployment's own
    # instructions are silently missing from the index.
    find -L "$g" -name '*.md' -type f 2>/dev/null
  done < <(sources_globs) | grep -v '/node_modules/' | sort -u
}

cmd_index() {
  mkdir -p "$KB_DIR/notes"
  rm -f "$DB"
  sqlite3 "$DB" <<'SQL'
CREATE VIRTUAL TABLE docs USING fts5(path UNINDEXED, title, body, superseded_by UNINDEXED, tokenize='unicode61 remove_diacritics 2');
SQL

  # One python pass over the whole corpus rather than one process per file. Not for speed:
  # `supersedes:` can only be resolved once every note has been read, because the note that
  # retires a fact is usually written long after the one it retires.
  local list n
  list=$(mktemp)
  sources > "$list"
  n=$(python3 - "$DB" "$list" <<'PY'
import os, re, sqlite3, sys

db, listfile = sys.argv[1], sys.argv[2]
paths = [l.strip() for l in open(listfile, encoding='utf-8') if l.strip()]
FRONT = re.compile(r'^---\s*\n(.*?)\n---\s*\n?', re.S)

def keys(path):
    """The names a note may be referred to by: full path, filename, or slug."""
    base = os.path.basename(path)
    return {path, base, base[:-3] if base.endswith('.md') else base}

docs, retires = [], {}
for p in paths:
    if not os.path.isfile(p):
        continue
    try:
        raw = open(p, encoding='utf-8', errors='replace').read()
    except OSError:
        continue
    meta = {}
    m = FRONT.match(raw)
    if m:
        for line in m.group(1).splitlines():
            if ':' in line and not line.lstrip().startswith('#'):
                k, v = line.split(':', 1)
                meta[k.strip()] = v.strip()
    title = next((l[2:].strip() for l in raw.splitlines() if l.startswith('# ')), '')
    docs.append((p, title or os.path.basename(p)[:-3], raw))
    for ref in (x.strip() for x in meta.get('supersedes', '').split(',')):
        if ref:
            retires[ref] = p

con = sqlite3.connect(db)
for path, title, body in docs:
    # A note never retires itself, however it names itself.
    by = next((retires[k] for k in keys(path) if k in retires and retires[k] != path), '')
    con.execute("INSERT INTO docs(path,title,body,superseded_by) VALUES(?,?,?,?)",
                (path, title, body, by))
con.commit(); con.close()
print(len(docs))
PY
)
  rm -f "$list"
  [ -n "$n" ] || n=0

  # INDEX.md is the cheap path: one line per document, ~2k tokens for a 100-document corpus.
  # The agent reads this, decides, and opens exactly one file — that is the whole trick, and
  # it is why AGENTS.md names it as step one.
  {
    echo "# Knowledge Index"
    echo
    echo "_Generated by \`kb index\` — do not edit by hand. $n documents._"
    echo
    python3 - "$DB" <<'PY'
import re, sqlite3, sys
con = sqlite3.connect(sys.argv[1])
# Superseded notes stay on disk and stay searchable — append-only is the point, and the record
# of what was once true is sometimes the thing you need. They are kept OUT of this index: it is
# read on every single run, and a retired price sitting next to the current one is an invitation
# to cite the wrong one.
retired = 0
for path, title, body, by in con.execute(
        "SELECT path,title,body,superseded_by FROM docs ORDER BY path"):
    if by:
        retired += 1
        continue
    hook = ""
    # Front matter is searchable but is never the hook: it is machine input, and a note whose
    # index entry reads "---" tells a reader nothing about whether to open it.
    body = re.sub(r'^---\s*\n.*?\n---\s*\n?', '', body, count=1, flags=re.S)
    for line in body.splitlines():
        s = line.strip()
        if not s or s.startswith('#') or s.startswith('!['):
            continue
        # Skip fully-italic metadata ("_Recorded ..._"). It is the first prose line in every
        # generated note, so using it would make every index entry read identically.
        if s.startswith('_') and s.endswith('_'):
            continue
        if s.startswith('<!--'):
            continue
        hook = s[:110]
        break
    print(f"- [{title}]({path}) — {hook}")
if retired:
    print()
    print(f"_{retired} note(s) superseded and not listed. `kb search` still finds them._")
con.close()
PY
  } > "$INDEX_MD"

  echo "kb: indexed $n documents -> $DB"
  echo "kb: wrote $INDEX_MD"
}

cmd_search() {
  local q="${1:?usage: kb search \"query\"}"
  [ -f "$DB" ] || { echo "kb: no index yet — run 'kb index'" >&2; exit 1; }

  python3 - "$DB" "$q" <<'PY'
import sqlite3, sys, re
db, q = sys.argv[1], sys.argv[2]
con = sqlite3.connect(db)

# FTS5 has its own query grammar and a plain search phrase is not valid input to it:
# "fine-grained" parses as a column filter and fails with 'no such column: grained'. Since
# people type phrases rather than FTS5 expressions, each word is extracted and quoted.
#
# Joined with AND, not OR: every added word must narrow the result, which is what searching
# means. An OR-join does the opposite — longer queries return more noise and the top hit has
# nothing to do with the phrase. Ranking cannot repair that; it only orders what got in.
terms_q = re.findall(r"\w+", q, flags=re.UNICODE)
if not terms_q:
    print("kb: nothing searchable in that query", file=sys.stderr); sys.exit(2)
match = " AND ".join('"%s"' % w.replace('"', '""') for w in terms_q)

try:
    hits = con.execute(
        "SELECT path,title,superseded_by FROM docs WHERE docs MATCH ? ORDER BY rank LIMIT 20",
        (match,)
    ).fetchall()
except sqlite3.OperationalError as e:
    print(f"kb: bad query: {e}", file=sys.stderr); sys.exit(2)

# Superseded notes are demoted, not hidden. Hiding them would answer "what is our price" with
# silence once the old note is retired and before anyone searches for the new one; and the
# record of what was true last quarter is occasionally the thing being asked for. What must not
# happen is a retired fact being presented as current, so they are listed separately, named as
# retired, and pointed at what replaced them.
rows    = [(p, t) for p, t, by in hits if not by][:10]
retired = [(p, t, by) for p, t, by in hits if by][:5]

if not rows and not retired:
    # 1, like grep: "found nothing" is not success. Exiting 0 makes
    # `kb search X && do-something` fire on an empty result.
    print("kb: no matches"); sys.exit(1)
terms = [t for t in re.findall(r"\w+", q) if len(t) > 2]
for path, title in rows:
    print(f"\n{title}")
    try:
        lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
    except OSError:
        continue
    shown = 0
    for i, line in enumerate(lines, 1):
        if any(t.lower() in line.lower() for t in terms):
            print(f"  {path}:{i}: {line.strip()[:140]}")
            shown += 1
            if shown >= 3:
                break
    if not shown:
        print(f"  {path}:1")

if retired:
    print()
    print("superseded — do not treat these as current:")
    for path, title, by in retired:
        print(f"  {title}")
        print(f"    {path}  ->  replaced by {by}")
if not rows:
    sys.exit(1)
con.close()
PY
}

cmd_add() {
  local title="${1:?usage: kb add \"title\" [< content]}"

  # An existing path as the title means someone meant `kb add "title" < file`. Left alone this
  # silently creates a note called "tmp-n-md" holding nothing, and the finding it was meant to
  # record is lost without a single error message.
  if [ -e "$title" ]; then
    echo "kb: '$title' is a file, not a title." >&2
    echo "    kb add \"A title\" < $title" >&2
    exit 2
  fi
  mkdir -p "$KB_DIR/notes"
  local slug stamp file
  slug=$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//' | cut -c1-60)
  stamp=$(date -u '+%Y%m%d')
  file="$KB_DIR/notes/${stamp}-${slug}.md"
  [ -e "$file" ] && file="$KB_DIR/notes/${stamp}-${slug}-$(date -u '+%H%M%S').md"
  cat > "$file" <<EOF
# $title

_Recorded $(date -u '+%Y-%m-%d') UTC._

EOF
  # Content on stdin lands in the note directly. Agents record findings mid-task; making them
  # write a title and then edit the file separately is a step they will skip.
  [ -t 0 ] || cat >> "$file"
  echo "$file"
}

cmd_schema() {
  cat <<EOF
kb — this agent's memory

Storage : $DB (SQLite FTS5, single file, no server)
Index   : $INDEX_MD (one line per document — read this first, it is ~2k tokens)

Sources (resolved):
EOF
  local g
  while IFS= read -r g; do
    [ -n "$g" ] && printf '          %s/**/*.md\n' "$g"
  done < <(sources_globs)
  cat <<EOF

Table   : docs(path UNINDEXED, title, body, superseded_by UNINDEXED)
          tokenizer: unicode61, diacritics folded

Commands:
  kb index          rebuild from sources (safe any time; full rebuild)
  kb search "..."   ranked search, prints path:line
  kb add "title"    new note in knowledge/notes/ (content from stdin if piped)

Writing : append markdown to knowledge/notes/, one file per finding. The index is rebuilt
          separately. SQLite allows one writer, so never write to index.db directly — that
          is what keeps concurrent runs safe.

Correcting a fact that has changed — a price, a contact, a policy — is done by writing a
NEW note that retires the old one, never by editing the old one:

    ---
    supersedes: 20260114-support-hours
    ---
    # Support hours

Name the old note by its slug, filename or path. The retired note stays on disk and stays
findable by \`kb search\`, which labels it and points at its replacement; it drops out of
INDEX.md, because that is read on every run and a retired fact sitting beside the current
one is an invitation to cite the wrong one.

Append-only is what makes concurrent writers safe. This keeps that property while still
letting the agent unlearn — without it, notes only accumulate, and something retired
eventually gets quoted back to a client as current.
EOF
  if [ -f "$DB" ]; then
    echo
    echo "Currently indexed: $(sqlite3 "$DB" "SELECT count(*) FROM docs;" 2>/dev/null || echo '?') documents"
  else
    echo
    echo "Currently indexed: none — run 'kb index'"
  fi
}

case "${1:-}" in
  index)   shift; cmd_index "$@" ;;
  search)  shift; cmd_search "$@" ;;
  add)     shift; cmd_add "$@" ;;
  sources) sources_globs ;;
  schema)  shift; cmd_schema "$@" ;;
  *)       cmd_schema ;;
esac

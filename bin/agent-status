#!/usr/bin/env bash
# agent-status — what has this agent been doing?
#
#   agent-status              the last runs: when, how long, outcome, cost of failure
#   agent-status <job>        the same, for one job, plus the last failure's reason
#   agent-status --effects    what this deployment changed OUTSIDE the container
#   agent-status --ready      exit 1 if this fork is not finished (no jobs, no context, ...)
#   agent-status --health     exit 1 if the most recent run of any job failed (HEALTHCHECK)
#   agent-status --json       machine-readable, for a host-side check
#
# Observability here is files in the volume, read on demand — not a daemon and not a port.
# It survives restarts, exposes no new surface inside the client's network, works the same on
# a rented box and on a machine in their office, and the client can read it themselves. That
# last property is worth more for trust than any dashboard.
set -uo pipefail

DATA="${AGENT_DATA:-/data}"
RUNS="$DATA/logs/runs"
LOG="$DATA/logs/runs.jsonl"
LIMIT="${AGENT_STATUS_LIMIT:-15}"

MODE=table
JSON=0
JOB=""
# --json is a modifier rather than a mode, so it composes with --memory. On its own it keeps
# its old meaning: the run table, as JSON.
while [ $# -gt 0 ]; do
  case "$1" in
    --health)  MODE=health; shift ;;
    --memory)  MODE=memory; shift ;;
    --effects) MODE=effects; shift ;;
    --ready)   MODE=ready; shift ;;
    --json)   JSON=1; shift ;;
    -n)       LIMIT="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)        JOB="$1"; shift ;;
  esac
done
[ "$MODE" = table ] && [ "$JSON" = 1 ] && MODE=json

# The boot this container recorded, used below to tell "failing now" from "failed once, long
# ago". Empty when there is no evidence yet, and every use falls back to old behaviour.
THIS_BOOT=$(sed -n '$s/.*"boot_utc":"\([^"]*\)".*/\1/p' "$DATA/logs/boots.jsonl" 2>/dev/null)

# Health is judged from the last run of each job. A fresh deployment that has never run is
# healthy — "not started yet" is not a fault, and reporting it as one would make every new
# client deployment look broken on arrival.
if [ "$MODE" = health ]; then
  [ -d "$RUNS" ] || exit 0
  rc=0
  for f in "$RUNS"/*/last.json; do
    [ -e "$f" ] || continue
    # Only failures from THIS boot count. last.json lives in the volume, so without this a
    # job that failed yesterday makes every new container report unhealthy the moment it
    # starts — including the container carrying the fix. Platforms gate deployments on
    # health, so that turns one bad run into an un-deployable service.
    #
    # Both stamps use the same compact UTC format, so a string compare is a time compare.
    # History stays visible in `agent-status`; this only decides "is it failing now".
    e=$(python3 - "$f" "${THIS_BOOT:-}" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    print(0); raise SystemExit
boot = sys.argv[2]
started = str(d.get('started_utc', ''))
if boot and started and started < boot:
    print(0)            # a failure from before this container existed
else:
    print(d.get('exit', 0))
PY
) || e=0
    if [ "$e" != 0 ]; then
      echo "unhealthy: $(basename "$(dirname "$f")") last exited $e"
      rc=1
    fi
  done
  [ "$rc" = 0 ] && echo "ok"
  exit $rc
fi

# --- memory: did this deployment keep what it learned? ------------------------------
if [ "$MODE" = memory ]; then
  python3 - "$DATA" "$JSON" <<'PY'
import json, os, sys, glob
data, want_json = sys.argv[1], sys.argv[2] == "1"
logs = os.path.join(data, "logs")

def lines(name):
    out = []
    try:
        for ln in open(os.path.join(logs, name), encoding='utf-8', errors='replace'):
            ln = ln.strip()
            if ln:
                try: out.append(json.loads(ln))
                except json.JSONDecodeError: pass
    except OSError:
        pass
    return out

origin = {}
try:
    origin = json.load(open(os.path.join(logs, "origin.json")))
except Exception:
    pass
boots, builds = lines("boots.jsonl"), lines("builds.jsonl")

# Only transitions between two KNOWN build ids are evidence. A checkout has no .build-id and
# records "unknown"; counting that as a build would let a deployment claim it survived a
# redeploy that never happened.
known = [b.get("build") for b in builds if b.get("build") and b.get("build") != "unknown"]
distinct = sorted(set(known), key=known.index)

survived_restart  = len(boots) >= 2
survived_redeploy = len(distinct) >= 2

# Corroboration from real memory rather than from the evidence files, so the two can be
# compared: a deployment whose logs survived but whose knowledge base did not is a different
# fault, and the operator should be able to see it.
runs = 0
try:
    runs = sum(1 for ln in open(os.path.join(data, "logs", "runs.jsonl"),
                                encoding='utf-8', errors='replace') if ln.strip())
except OSError:
    pass
notes = len(glob.glob(os.path.join(data, "knowledge", "notes", "*.md")))

state = ("damaged" if boots and not origin
         else "proven" if (survived_restart or survived_redeploy)
         else "unproven")
code = {"proven": 0, "unproven": 1, "damaged": 2}[state]

if want_json:
    json.dump({
        "volume_id": origin.get("volume_id"),
        "first_seen_utc": origin.get("first_seen_utc"),
        "boots": len(boots),
        "builds": len(distinct),
        "current_build": (boots[-1].get("build") if boots else None),
        "survived_restart": survived_restart,
        "survived_redeploy": survived_redeploy,
        "runs": runs, "notes": notes,
        "state": state,
    }, sys.stdout, indent=2)
    print()
    raise SystemExit(code)

print("memory (%s)" % data)
print(f"  volume id      {origin.get('volume_id', '-')}     <- record this; it must not change")
print(f"  first seen     {origin.get('first_seen_utc', '-')}")
print(f"  boots          {len(boots)}" + (f"   (this one {boots[-1].get('boot_utc')})" if boots else ""))
print(f"  image builds   {len(distinct)}" + (f"   (now {distinct[-1]})" if distinct else ""))
print(f"  corroboration  {runs} run(s) recorded, {notes} knowledge note(s)")
print()

# The verdict always names WHICH survival is proven. "12 boots, persisting" is a lie by
# omission when all twelve share one image: restarts are not redeploys, and surviving a
# redeploy is the promise being made.
if state == "damaged":
    print("VERDICT: /data is DAMAGED — boots are recorded but the volume's identity file is")
    print("         gone. Something removed part of the volume. Treat memory as unreliable")
    print("         and restore from backup.")
elif survived_redeploy:
    print(f"VERDICT: /data is persisting. It has outlived {len(boots) - 1} restart(s) and")
    print(f"         {len(distinct) - 1} redeploy(s) — the last redeploy did not lose memory.")
elif survived_restart:
    print(f"VERDICT: /data outlived {len(boots) - 1} container restart(s), but this deployment")
    print("         has only ever run one image build. Surviving a restart is NOT proof of")
    print("         surviving a redeploy. Push a change and run this again.")
else:
    print("VERDICT: only this boot is recorded. That is normal for a first deploy and is NOT")
    print("         proof of anything else. If this deployment has been deployed before, its")
    print("         memory was not kept. Deploy once more and run this again — two boots under")
    print("         the same volume id is the proof. See DEPLOY.md.")
raise SystemExit(code)
PY
  exit $?
fi

# --- ready: is this fork actually finished? ------------------------------------------
# A half-filled fork deploys, reports healthy, and idles politely forever doing nothing. That
# is the worst way for it to fail, because everything looks fine — so this says out loud what
# is missing, and the idle banner prints it where a platform's log tab shows it.
#
# Deliberately NOT part of --health. Health is the HEALTHCHECK, and a deployment nobody has
# configured yet is not sick; making it unhealthy would block the very deploy that carries the
# configuration.
if [ "$MODE" = ready ]; then
  problems=0
  note() { echo "$@"; problems=$((problems + 1)); }

  jobs=0
  for f in "$DATA/jobs"/*.md; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = README.md ] && continue
    jobs=$((jobs + 1))
  done
  [ "$jobs" = 0 ] && note "no jobs: this agent has nothing it can be asked to do.
  Add one to agent/jobs/ — see its README."

  # A fork that never replaced context/ has not been told who it works for. The marker is in
  # the template's own README, so any real file — added or written over it — counts.
  ctx=0
  for f in "$DATA/context"/*; do
    [ -f "$f" ] || continue
    grep -q 'agent-template:placeholder' "$f" 2>/dev/null && continue
    ctx=$((ctx + 1))
  done
  [ "$ctx" = 0 ] && note "no context: agent/context/ is still the template's placeholder.
  The agent does not know who it works for, what is in scope, or what it must never touch."

  agent-secret check -q 2>/dev/null || note "not configured: $(agent-secret check 2>&1 | head -3 | tr '\n' ' ')"

  if [ -n "$(find "${AGENT_APP:-/app}/agent/mcp" -name '*.json' 2>/dev/null)" ]; then
    agent-mcp check >/dev/null 2>&1 || note "MCP definitions do not resolve: run agent-mcp check"
  fi

  # Building each job's command catches what static checks cannot: a job naming a skill that
  # was never shipped, a prompt that is missing, front matter that does not parse. It costs
  # nothing — --dry-run touches nothing and calls no model.
  for f in "$DATA/jobs"/*.md; do
    [ -e "$f" ] || continue
    j="$(basename "$f" .md)"; [ "$j" = README ] && continue
    agent-run "$j" --dry-run >/dev/null 2>&1 || note "job '$j' does not build: run agent-run $j --dry-run"
  done

  if [ "$problems" = 0 ]; then
    echo "ready: $jobs job(s), context configured, credentials present"
    exit 0
  fi
  echo
  echo "$problems thing(s) to finish before this deployment can do anything."
  exit 1
fi

# --- effects: what did this deployment change outside itself? -----------------------
# runs.jsonl answers "what ran". After an incident nobody asks that; they ask what was
# touched. Built-in tools cannot leave the container, so every external effect is an MCP call
# and the ledger is complete by construction — see agent/extensions/mcp-tools.ts.
if [ "$MODE" = effects ]; then
  python3 - "$DATA/logs/effects.jsonl" "$LIMIT" "$JOB" "$JSON" <<'PY'
import json, os, sys
path, limit, job, want_json = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4] == "1"

events = []
try:
    for ln in open(path, encoding='utf-8', errors='replace'):
        ln = ln.strip()
        if ln:
            try: events.append(json.loads(ln))
            except json.JSONDecodeError: pass
except OSError:
    if want_json:
        print("[]"); raise SystemExit(0)
    print("no external effects recorded.")
    print("  Either nothing has reached outside the container, or no job here declares mcp.")
    raise SystemExit(0)

# Pair the two phases by call id. An unpaired `start` is the one that matters: something was
# sent to a client's system and no completion was ever recorded, so whether it landed is
# unknown. That is a different fact from "it failed", and it must not be rendered as one.
calls, order = {}, []
for e in events:
    cid = e.get("call")
    if not cid:
        continue
    if cid not in calls:
        calls[cid] = {}
        order.append(cid)
    calls[cid].update(e if e.get("phase") == "start" else
                      {k: v for k, v in e.items() if k not in ("utc", "phase")})
    if e.get("phase") == "end":
        calls[cid]["outcome"] = e.get("outcome", "ok")

rows = [calls[c] for c in order]
if job:
    rows = [r for r in rows if r.get("job") == job]
rows = rows[-limit:]

if want_json:
    json.dump(rows, sys.stdout, indent=2); print(); raise SystemExit(0)

if not rows:
    print(f"no external effects recorded{' for ' + job if job else ''}.")
    raise SystemExit(0)

print(f"{'when (UTC)':<18} {'job':<14} {'tool':<30} {'outcome':<10} {'ms':>6}")
print("-" * 84)
unknown = failed = 0
for r in rows:
    outcome = r.get("outcome")
    if outcome is None:
        shown, unknown = "UNFINISHED", unknown + 1
    elif outcome != "ok":
        shown, failed = "ERROR", failed + 1
    else:
        shown = "ok"
    tool = f"{r.get('server','?')}__{r.get('tool','?')}"
    print(f"{r.get('utc',''):<18} {r.get('job',''):<14} {tool:<30} {shown:<10} "
          f"{str(r.get('ms','-')):>6}")
    if r.get("error"):
        print(f"{'':18} {'':14} -> {str(r['error'])[:56]}")

print()
print(f"{len(rows)} call(s), {failed} failed, {unknown} with no recorded outcome")
if unknown:
    print()
    print("UNFINISHED means the call was sent and no completion was ever recorded — the run")
    print("was killed mid-call, or the process died. Whether the far side applied it is not")
    print("knowable from here. Check the target system before re-running the job.")

# Argument values are deliberately absent: they are the payload that reached the client's
# systems. Keys and a digest are recorded instead. AGENT_EFFECTS_VERBOSE=1 changes that while
# building a vertical, and should not be left on.
PY
  exit $?
fi

# One line, only when the evidence is thin. Someone reading this daily should see nothing;
# someone whose deployment is quietly losing its memory should not be able to miss it.
# A wc -l rather than a second python start, since this runs on every invocation.
if [ "$MODE" = table ] && [ "$(wc -l < "$DATA/logs/boots.jsonl" 2>/dev/null || echo 0)" -le 1 ]; then
  echo "! only one boot recorded — persistence unproven. Run: agent-status --memory"
  echo
fi

[ -f "$LOG" ] || { echo "no runs recorded yet."; echo "  Run one with: agent-run <job>   ('agent-run --list' shows them)"; exit 0; }

python3 - "$LOG" "$LIMIT" "$JOB" "$MODE" "$RUNS" <<'PY'
import json, sys, os
log, limit, job, mode, runs = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]

MEANING = {
    0:  "ok",
    10: "not configured",
    11: "already running",
    20: "provider/auth",
    21: "provider busy",
    22: "timed out",
    30: "no result",
    31: "contract not met",
    32: "escalated",
    40: "internal error",
}

rows = []
for line in open(log, encoding='utf-8', errors='replace'):
    line = line.strip()
    if not line:
        continue
    try:
        rows.append(json.loads(line))
    except json.JSONDecodeError:
        continue
if job:
    rows = [r for r in rows if r.get('job') == job]
rows = rows[-limit:]

if mode == 'json':
    json.dump(rows, sys.stdout, indent=2)
    print()
    sys.exit(0)

if not rows:
    print(f"no runs recorded{' for ' + job if job else ''}.")
    sys.exit(0)

print(f"{'started (UTC)':<18} {'job':<16} {'took':>6} {'cost':>8}  outcome")
print("-" * 70)
failures = []
total = 0.0
for r in rows:
    code = int(r.get('exit', 40))
    label = MEANING.get(code, f"exit {code}")
    mark = " " if code == 0 else "!"
    cost = float(r.get('cost_usd', 0) or 0)
    total += cost
    shown = f"${cost:.4f}" if cost else "-"
    print(f"{r.get('started_utc',''):<18} {r.get('job',''):<16} "
          f"{str(r.get('duration_s',0))+'s':>6} {shown:>8}  {mark}{label}")
    if code != 0:
        failures.append(r)

ok = sum(1 for r in rows if int(r.get('exit', 40)) == 0)
print()
# Cost is on the table from day one because it is the first thing a client asks and the last
# thing anyone instruments. A real number in week one is worth more than an estimate.
print(f"{ok}/{len(rows)} succeeded    total ${total:.4f}")

# The reason belongs next to the failure. Making someone find the run directory and open a
# log is how a failure stays unexplained until it repeats.
if failures:
    last = failures[-1]
    d = last.get('dir', '')
    print()
    print(f"last failure — {last.get('job')} at {last.get('started_utc')} "
          f"({MEANING.get(int(last.get('exit',40)), '')})")
    # The provider's own message, captured from the run stream, is the useful one. pi often
    # writes nothing to stderr for an API-level failure, so stderr alone leaves it blank.
    reason = (last.get('error') or '').strip()
    if reason:
        print(f"  {reason[:200]}")
    else:
        err = os.path.join(d, 'stderr.log')
        if os.path.isfile(err):
            for line in [l.rstrip() for l in open(err, encoding='utf-8', errors='replace') if l.strip()][:3]:
                print(f"  {line[:110]}")
    print(f"  full record: {d}")
PY

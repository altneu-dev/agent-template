#!/usr/bin/env bash
# agent-init — make /data usable. Idempotent, safe to run at any time, never destructive.
#
#   agent-init            prepare /data
#   agent-init --check    report what it would do, change nothing (exit 1 if not ready)
#
# Why this is a command and not just entrypoint code: a platform supervisor may replace the
# container's start command — OpenShell does exactly that — and anything load-bearing that
# only ever ran from an entrypoint would then silently not run at all. The entrypoint calls
# this; so can a human, a job, or a supervisor.
#
# The layout it creates is the /app vs /data split:
#
#   symlinks into /app   AGENTS.md, context, skills, jobs, mcp, extensions
#                        Repo content. Always current after a deploy, because they point at
#                        the image rather than being copied once and then going stale — the
#                        failure that made the previous generation ship `.new` files for a
#                        human to merge by hand.
#   real directories     knowledge/notes, logs/runs, work, .pi
#                        State. Seeded once from the repo, then owned by the agent.
set -uo pipefail

APP="${AGENT_APP:-/app}"
DATA="${AGENT_DATA:-/data}"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1

problems=0
pending=0
note()  { [ "$CHECK" = 1 ] && echo "  $*"; }
# Anything --check would have done means /data is not ready yet. Counting those separately
# from failures is what lets --check double as a readiness probe for CI and healthchecks.
todo()  { pending=$((pending + 1)); note "$*"; }
fail()  { echo "agent-init: $*" >&2; problems=$((problems + 1)); }

if [ ! -d "$DATA" ]; then
  fail "$DATA does not exist"
  exit 1
fi
if [ "$CHECK" = 0 ] && [ ! -w "$DATA" ]; then
  # The classic container mistake: a volume owned by a uid the container does not run as.
  fail "$DATA is not writable by uid $(id -u) — check the volume's ownership"
  exit 1
fi

# --- state: create once, never touch again ------------------------------------------
for d in knowledge/notes logs/runs work .pi/agent; do
  if [ -d "$DATA/$d" ]; then
    note "exists: $d"
  elif [ "$CHECK" = 1 ]; then
    todo "would create: $d"
  else
    mkdir -p "$DATA/$d" || fail "cannot create $DATA/$d"
  fi
done

# --- persistence evidence -----------------------------------------------------------
# A wiped /data and a healthy one look identical from inside: this script recreates the
# layout happily either way, agent-status shows no runs, kb returns nothing. On a platform
# that derives the volume name rather than taking the one we declare, that means memory can
# be lost on every deploy while the deployment reports itself healthy.
#
# So the deployment records enough to answer the question itself. Three files, because the
# oldest evidence is the most valuable and a single trimmed log destroys exactly that:
#
#   origin.json    written once, never rewritten — the volume's identity
#   builds.jsonl   one line when the image changes — the redeploy ledger
#   boots.jsonl    one line per container start   — trimmed, the cheapest signal
#
# Written here rather than in the entrypoint for the reason at the top of this file: a
# platform supervisor may replace the start command, and evidence that only ran from an
# entrypoint would be missing in precisely the deployment that needs it.
record_evidence() {
  local logs="$DATA/logs"
  [ -d "$logs" ] || return 0

  local now build commit boot_key
  now=$(date -u '+%Y%m%dT%H%M%SZ')

  # Absent when running from a checkout rather than a built image (the universality gate
  # does this). Recorded as "unknown", and the verdict only counts transitions between two
  # KNOWN build ids — so unknown never manufactures redeploy evidence.
  build=$(cat "$APP/.build-id" 2>/dev/null) || build=""
  [ -n "$build" ] || build="unknown"

  # A label only. Platforms set it inconsistently, so nothing may depend on it.
  commit=$(printf '%s' "${SOURCE_COMMIT:-}" | tr -cd 'a-zA-Z0-9._-' | cut -c1-40)

  # One line per CONTAINER, not per call: this function also runs on every agent-run
  # preflight, and an undeduplicated append would turn a busy day into a hundred fake boots
  # and make the count meaningless. PID 1's start time on this host's boot is constant for
  # the life of a container and different in the next one.
  #
  # Fields are counted after the last ')' because /proc/1/stat's comm field can itself
  # contain spaces and parentheses. Hashed so the host's boot_id never sits in a file a
  # client can read. The fallback over-counts boots, which is the safe direction: it can
  # never invent redeploy evidence, only restart evidence.
  boot_key=$( { cat /proc/sys/kernel/random/boot_id 2>/dev/null
                sed 's/.*) //' /proc/1/stat 2>/dev/null | awk '{print $20}'; } \
              | sha256sum 2>/dev/null | cut -c1-12 )
  [ -n "$boot_key" ] || boot_key=$(cat /etc/hostname 2>/dev/null | sha256sum | cut -c1-12)

  # Identity: written once and never again, so a changed volume_id is unambiguous proof of a
  # different volume rather than of anything this script did.
  if [ ! -f "$logs/origin.json" ]; then
    printf '{"volume_id":"%s","first_seen_utc":"%s","first_build":"%s"}\n' \
      "$(head -c 16 /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-' | cut -c1-12)" \
      "$now" "$build" > "$logs/origin.json" 2>/dev/null
  fi

  # Lineage: one line when the image content changed. Never trimmed — this is the record
  # that answers "did the last redeploy keep my memory", and it is a line per push at most.
  local last_build=""
  [ -f "$logs/builds.jsonl" ] && last_build=$(sed -n '$s/.*"build":"\([^"]*\)".*/\1/p' "$logs/builds.jsonl")
  if [ "$build" != "$last_build" ]; then
    printf '{"utc":"%s","build":"%s","commit":"%s"}\n' "$now" "$build" "$commit" \
      >> "$logs/builds.jsonl" 2>/dev/null
  fi

  # Boots: skip if this container already recorded one. A single short append is atomic, so
  # two containers starting together during a rolling deploy cannot interleave a torn line.
  if ! grep -q "\"boot\":\"$boot_key\"" "$logs/boots.jsonl" 2>/dev/null; then
    printf '{"boot_utc":"%s","boot":"%s","build":"%s","commit":"%s"}\n' \
      "$now" "$boot_key" "$build" "$commit" >> "$logs/boots.jsonl" 2>/dev/null
    # Bounded, and trimmed well above the point where the count still reads as evidence.
    local n
    n=$(wc -l < "$logs/boots.jsonl" 2>/dev/null || echo 0)
    if [ "$n" -gt 2000 ] 2>/dev/null; then
      tail -n 1000 "$logs/boots.jsonl" > "$logs/boots.jsonl.tmp" 2>/dev/null \
        && mv "$logs/boots.jsonl.tmp" "$logs/boots.jsonl" 2>/dev/null
    fi
  fi
}

# --check is a readiness probe and the healthcheck's neighbour. A probe that mutates state is
# one you cannot run twice, so it observes and never records.
[ "$CHECK" = 0 ] && record_evidence

# --- repo content: symlink, so a deploy updates it ----------------------------------
# A real file that a fork later changes would go stale here forever, because seeding only
# ever happens once. Pointing at /app means `git push` is the update mechanism.
link() {
  local target="$1" name="$2" path="$DATA/$2"
  [ -e "$target" ] || { note "skip (absent in image): $name"; return 0; }
  if [ -L "$path" ] && [ "$(readlink "$path")" = "$target" ]; then
    note "linked: $name"
    return 0
  fi
  if [ -e "$path" ] && [ ! -L "$path" ]; then
    # Someone put a real file where a link belongs. Do not delete their work.
    fail "$path is a real file, not a link to $target — move it aside to let the image own it"
    return 0
  fi
  [ "$CHECK" = 1 ] && { todo "would link: $name -> $target"; return 0; }
  ln -sfn "$target" "$path" || fail "cannot link $path"
}

link "$APP/agent/AGENTS.md"   AGENTS.md
link "$APP/agent/context"     context
link "$APP/agent/skills"      skills
link "$APP/agent/jobs"        jobs
link "$APP/agent/mcp"         mcp
link "$APP/agent/extensions"  extensions

# --- seed the knowledge base, without ever overwriting ------------------------------
# The repo may ship starting material. It is copied in only where nothing exists, so an
# agent's own notes always win over the image's copy.
if [ -d "$APP/knowledge/notes" ]; then
  while IFS= read -r src; do
    rel="${src#"$APP/knowledge/notes/"}"
    dst="$DATA/knowledge/notes/$rel"
    [ -e "$dst" ] && continue
    if [ "$CHECK" = 1 ]; then todo "would seed: knowledge/notes/$rel"; continue; fi
    mkdir -p "$(dirname "$dst")" 2>/dev/null
    cp "$src" "$dst" 2>/dev/null || fail "cannot seed $rel"
  done < <(find "$APP/knowledge/notes" -type f -name '*.md' 2>/dev/null)
fi

# --- pi settings: seed once, then the instance owns them ----------------------------
if [ -f "$APP/agent/pi-settings.json" ] && [ ! -f "$DATA/.pi/agent/settings.json" ]; then
  if [ "$CHECK" = 1 ]; then
    todo "would seed: .pi/agent/settings.json"
  else
    cp "$APP/agent/pi-settings.json" "$DATA/.pi/agent/settings.json" 2>/dev/null \
      || fail "cannot seed pi settings"
  fi
fi

[ "$problems" -gt 0 ] && exit 1
if [ "$CHECK" = 1 ]; then
  if [ "$pending" -gt 0 ]; then
    echo "agent-init: $DATA is not ready — $pending item(s) above still to do"
    exit 1
  fi
  echo "agent-init: $DATA is ready"
fi
exit 0

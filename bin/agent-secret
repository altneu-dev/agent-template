#!/usr/bin/env bash
# agent-secret — read one configured value, and check the deployment is configured at all.
#
#   agent-secret get NAME     print the value (exit 1 if unset)
#   agent-secret has NAME     exit 0 if set to something non-placeholder
#   agent-secret names        list the names that are set — never the values
#   agent-secret check        compare .env.example against what is actually set
#   agent-secret check -q     same, silent, exit 1 if anything is missing
#
# Two sources, in order: the process environment, then a mounted secrets file. The
# environment is how a one-click platform injects configuration; the file is for a client who
# wants credentials on disk under their own control. Supporting both means the deploy story
# does not change with the customer's policy.
#
# The file is PARSED, never sourced. Sourcing executes arbitrary shell from a file that
# arrives from outside, and `set -a` would additionally push every value into the
# environment of every child process — readable from /proc/<pid>/environ by anything the
# agent spawns. Reading one value on demand keeps the blast radius to the value asked for.
set -uo pipefail

ENV_FILE="${AGENT_ENV_FILE:-${AGENT_DATA:-/data}/.env}"
EXAMPLE="${AGENT_ENV_EXAMPLE:-${AGENT_APP:-/app}/.env.example}"

# A value that is still the placeholder is worse than a missing one: it looks configured
# everywhere except where it is used.
is_placeholder() {
  case "$1" in
    ""|"<required>"|"<REQUIRED>"|"changeme"|"CHANGEME") return 0 ;;
    *) return 1 ;;
  esac
}

read_file_var() {
  local file="$1" want="$2"
  [ -f "$file" ] || return 1
  python3 - "$file" "$want" <<'PY'
import re, sys
path, want = sys.argv[1], sys.argv[2]
# Deliberately boring grammar: KEY=value, optional `export`, # comments, blank lines,
# matching surrounding quotes stripped. No command substitution, no line continuation.
LINE = re.compile(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$')
try:
    fh = open(path, encoding='utf-8', errors='replace')
except OSError:
    sys.exit(1)
for line in fh:
    if not line.strip() or line.lstrip().startswith('#'):
        continue
    m = LINE.match(line.rstrip('\n'))
    if not m or m.group(1) != want:
        continue
    v = m.group(2)
    if len(v) >= 2 and v[0] == v[-1] and v[0] in ('"', "'"):
        v = v[1:-1]                      # quoted: take it literally, '#' and all
    else:
        # Unquoted: strip a trailing comment, but only when whitespace precedes the '#'.
        # `KEEP=30   # note` -> 30, while a value that legitimately contains '#'
        # (`pass#word`) is untouched. Without this the comment becomes part of the value
        # and surfaces much later as an unparseable number or a failed login.
        v = re.sub(r'\s+#.*$', '', v).rstrip()
    sys.stdout.write(v)
    sys.exit(0)
sys.exit(1)
PY
}

# Three sources, in order: the environment (how a platform injects config), the mounted
# secrets file, then .env.example's own value as a default.
#
# That last fallback is what makes the committed example file the single source of truth for
# defaults: `AGENT_PROVIDER=anthropic` there means an operator who sets nothing still gets
# anthropic, instead of silently falling through to whatever the runtime's own default is.
# Placeholders are never used as defaults — `<required>` means required.
lookup() {
  local name="$1" val
  val="${!name-}"
  if [ -n "${val:-}" ]; then printf '%s' "$val"; return 0; fi
  if val=$(read_file_var "$ENV_FILE" "$name"); then printf '%s' "$val"; return 0; fi
  val=$(read_file_var "$EXAMPLE" "$name") || return 1
  is_placeholder "$val" && return 1
  printf '%s' "$val"
}

names_from() {
  # Names only. This output is printed, and a value in printed output ends up in a log or a
  # terminal buffer that outlives the reason it was needed.
  { env | grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' | tr -d '='
    [ -f "$ENV_FILE" ] && grep -oE '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE" \
      | sed -E 's/^[[:space:]]*(export[[:space:]]+)?//; s/=$//'
  } 2>/dev/null | sort -u
}

cmd_check() {
  local quiet=0
  [ "${1:-}" = "-q" ] || [ "${1:-}" = "--quiet" ] && quiet=1
  say() { [ "$quiet" = 1 ] || echo "$@"; }

  if [ ! -f "$EXAMPLE" ]; then
    say "no $EXAMPLE — cannot say what this deployment requires."
    return 0
  fi

  # Only entries whose example value is a placeholder are mandatory. Everything else in
  # .env.example carries a working default and is applied automatically by lookup(), so
  # demanding it here would make an operator set AGENT_RUN_KEEP=30 by hand to deploy.
  local missing="" placeholder="" n=0
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    local example_val
    example_val=$(read_file_var "$EXAMPLE" "$name") || continue
    is_placeholder "$example_val" || continue     # has a default; not required
    n=$((n + 1))
    local val
    if ! val=$(lookup "$name"); then missing="$missing $name"; continue; fi
    is_placeholder "$val" && placeholder="$placeholder $name"
  done < <(grep -oE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=' "$EXAMPLE" | tr -d ' =' | sort -u)

  local status=0
  if [ -n "$missing" ]; then
    say "missing (declared in .env.example, not set here):"
    for v in $missing; do say "  $v"; done
    status=1
  fi
  if [ -n "$placeholder" ]; then
    say "set but still a placeholder:"
    for v in $placeholder; do say "  $v"; done
    status=1
  fi
  if [ "$status" = 0 ]; then
    say "all $n required variable(s) are set"
  else
    say ""
    say "Set these in your platform's environment (or $ENV_FILE) and redeploy."
  fi
  return $status
}

case "${1:-check}" in
  get)
    name="${2:?usage: agent-secret get NAME}"
    val=$(lookup "$name") || { echo "agent-secret: $name is not set" >&2; exit 1; }
    is_placeholder "$val" && { echo "agent-secret: $name is still a placeholder" >&2; exit 1; }
    printf '%s' "$val"
    ;;
  has)
    name="${2:?usage: agent-secret has NAME}"
    val=$(lookup "$name") || exit 1
    is_placeholder "$val" && exit 1
    exit 0
    ;;
  names)  names_from ;;
  check)  shift; cmd_check "$@" ;;
  *)      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
